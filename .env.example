# ==============================================================================
# NAILS BY DIVYA — LOCAL ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and replace placeholder values with your local settings.
# Never commit real credentials or .env files to Git repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration (Phase 1B)
# ------------------------------------------------------------------------------
# Primary connection string (takes precedence if provided):
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=<mode>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/nailsbydivya_staging

# Individual parameters (used if DATABASE_URL is not provided):
PGHOST=localhost
PGPORT=5432
PGDATABASE=nailsbydivya_staging
PGUSER=postgres
PGPASSWORD=your_password_here
PGSSLMODE=disable

# Connection pool tuning
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3. AI & Knowledge Base Configuration (Divv AI)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for live chat responses)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Secret key required to trigger POST /rebuild-knowledge
ADMIN_API_KEY=your_admin_secret_key_here

# Optional: Path overrides
# FRONTEND_PATH=../../../../nailsbydivya/nailsbydivya-main
# DATABASE_PATH=knowledge/database.json
# MAX_RETRIEVED_SECTIONS=25
