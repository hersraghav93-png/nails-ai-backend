# ==============================================================================
# NAILS BY DIVYA — STAGING ENVIRONMENT CONFIGURATION TEMPLATE (.env.staging.example)
# Nails by Divya Platform — Phase 4A Staging Integration
#
# Instructions:
# 1. Copy this file to .env.staging on your staging hosting environment.
# 2. Populate isolated staging credentials. DO NOT reuse production secrets.
# 3. Never commit populated .env files to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment Identity
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=staging

# ------------------------------------------------------------------------------
# 2. Isolated Staging PostgreSQL Database
# ------------------------------------------------------------------------------
# Primary connection string (SSL required in staging/cloud environments):
DATABASE_URL=postgresql://nails_staging_user:your_staging_password_here@staging-db.nailsbydivya.store:5432/nailsbydivya_staging?sslmode=require

# Individual connection parameters:
PGHOST=staging-db.nailsbydivya.store
PGPORT=5432
PGDATABASE=nailsbydivya_staging
PGUSER=nails_staging_user
PGPASSWORD=your_staging_password_here
PGSSLMODE=require

# Connection pool tuning
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3. Explicit Staging CORS Allowlist (No Wildcards)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://staging.nailsbydivya.store,https://staging-admin.nailsbydivya.store,https://preview.nailsbydivya.store

# ------------------------------------------------------------------------------
# 4. Firebase Authentication (Staging Project)
# ------------------------------------------------------------------------------
# Create a dedicated staging project: 'nails-by-divya-staging'
# Enable Phone Authentication under Authentication -> Sign-in method.
# Download service account key from: Project Settings -> Service accounts
FIREBASE_PROJECT_ID=nails-by-divya-staging
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-staging@nails-by-divya-staging.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_STAGING_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional path override for service account JSON:
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/stagingServiceAccountKey.json

# ------------------------------------------------------------------------------
# 5. Official Meta WhatsApp Cloud API (Graph API v26.0)
# ------------------------------------------------------------------------------
# Current Meta Graph API version (Graph API v18.0 sunset on January 26, 2026)
WHATSAPP_PROVIDER=meta
WHATSAPP_GRAPH_API_VERSION=v26.0

# Meta Developer App -> WhatsApp -> API Setup:
WHATSAPP_API_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_staging_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_staging_waba_id_here

# Webhook verification & cryptographic signature validation:
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate_random_secret_string_for_staging_webhook

# STAGING RECIPIENT SAFETY GUARDRAIL:
# Outbound messages in staging are strictly restricted to this single test recipient.
# Set APPROVED=true only after verifying test recipient identity.
WHATSAPP_TEST_RECIPIENT_PHONE=+919811000001
WHATSAPP_TEST_RECIPIENT_APPROVED=false

# Studio primary contact:
STUDIO_WHATSAPP_PHONE=+919811000001

# ------------------------------------------------------------------------------
# 6. AI Grounding & Administrative Maintenance (Divv AI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview
ADMIN_API_KEY=your_staging_admin_rebuild_secret_key
